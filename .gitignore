# macOS finder droppings
.DS_Store

# The level references are photographs of an actual house, garden and the
# rooms inside it, and they arrive a roomful at a time. This repository is
# public, the game does not need them to build or run, and nothing under
# tools/ reads them - so the whole folder is out and the one drawing that
# is NOT a photograph is let back in by name. A new reference photo is
# therefore private by default rather than private only if somebody
# remembers to add a line here.
Assets/Concept/*
!Assets/Concept/level select layout.jpg
